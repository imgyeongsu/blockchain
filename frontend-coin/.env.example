# ──────────────────────────────────────────────────────────
# JackpotChain 코인부 환경 변수 예시
# 실제 사용 시 이 파일을 .env 또는 .env.local 로 복사하세요
# ──────────────────────────────────────────────────────────

# 블록체인 노드 RPC 주소 (기본: http://127.0.0.1:8332)
VITE_RPC_URL=http://127.0.0.1:8332

# RPC 포트 번호 (안내 문구용, 기본: 8332)
VITE_RPC_PORT=8332

# 학습부(Vue) 서비스 주소 (기본: http://localhost:5174)
VITE_LEARNING_URL=http://localhost:5174

# 실시간 데이터 폴링 주기 ms (기본: 15000)
VITE_POLL_INTERVAL_MS=15000

# JACK → POT 교환 비율 (기본: 100 JACK = 1 POT)
VITE_JACK_PER_POT=100

# 로또 UI 체험용 대기 카운트다운 초 (기본: 30)
# 실제 체인 규칙(N+30 블록)과 별개의 UI 파라미터입니다
VITE_LOTTO_WAIT_SEC=30

# localStorage 키 prefix (여러 환경을 한 브라우저에서 사용 시)
# 설정 안 하면 기본값(jackpotchain_*) 사용
# VITE_STORAGE_PREFIX=dev
