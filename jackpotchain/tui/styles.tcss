/* JackpotChain TUI Styles */

/* 색상 */
$primary: #00ff88;
$secondary: #00d4ff;
$warning: #ffbd2e;
$error: #ff5f56;
$bg-dark: #0c0c0c;
$bg-box: #1a1a2e;
$border: #444444;
$text-dim: #888888;
$text: #dddddd;

/* 전역 */
Screen {
    background: $bg-dark;
}

/* 메뉴 바 */
#menu-bar {
    dock: top;
    height: 3;
    width: 100%;
    background: $bg-dark;
    layout: horizontal;
}

#menu-bar > .menu-item {
    width: auto;
    min-width: 14;
    height: 3;
    padding: 0 2;
    color: #888888;
    background: #1a1a1a;
    border: solid #333333;
    content-align: center middle;
}

#menu-bar > .menu-item.active {
    color: #000000;
    background: $primary;
    border: solid $primary;
    text-style: bold;
}

/* 컨텐츠 영역 */
#content {
    padding: 1;
}

ContentSwitcher {
    width: 100%;
    height: 1fr;
}

/* 스크롤 가능한 위젯 */
#dashboard, #wallet, #mining, #lotto, #claims, #network {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

/* 로고 */
#logo {
    text-align: center;
    color: $primary;
    margin-bottom: 1;
    height: auto;
    border: solid $primary;
    padding: 1;
}

/* 메인 그리드 */
#main-grid {
    height: auto;
    margin-bottom: 1;
}

/* 통계 박스 */
.stat-box {
    border: solid #333333;
    background: #111111;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

#main-grid .stat-box {
    width: 1fr;
    margin-right: 1;
}

/* 박스 제목 */
.box-title {
    color: $primary;
    text-style: bold;
    border-bottom: solid $border;
    margin-bottom: 1;
}

.box-title-gold {
    color: $warning;
    text-style: bold;
    text-align: center;
}

/* 통계 행 */
Horizontal {
    height: auto;
}

.stat-label {
    color: $text-dim;
    width: 14;
}

.stat-value {
    color: $text;
}

/* 색상 */
.green { color: $primary; }
.cyan { color: $secondary; }
.yellow { color: $warning; }
.red { color: $error; }

/* 잭팟 박스 */
#jackpot-box {
    border: double $warning;
    background: #111111;
    padding: 1 2;
    text-align: center;
    height: auto;
}

.jackpot-amount {
    color: $primary;
    text-style: bold;
    text-align: center;
}

.prize-info {
    color: #888888;
    text-align: center;
}

/* 버튼 */
.action-buttons {
    height: auto;
    margin-top: 1;
}

.action-buttons Button {
    margin-right: 1;
}

/* 액션 버튼 행 */
.action-row {
    height: auto;
}

.action-btn {
    margin-right: 1;
}

/* Wallet 레이아웃 */
.wallet-left {
    width: 1fr;
    margin-right: 1;
}

.wallet-right {
    width: 1fr;
}

.wallet-row {
    height: auto;
    margin-bottom: 1;
}

/* Send 입력 */
#send-panel Input,
#exchange-panel Input {
    width: 1fr;
    margin-right: 1;
}

/* 테이블 */
DataTable {
    height: 6;
    margin-bottom: 0;
}

DataTable > .datatable--header {
    color: $primary;
    background: $bg-dark;
}

/* 로또 페이지 전용 */
.lotto-top {
    height: auto;
    margin-bottom: 1;
    layout: horizontal;
}

.lotto-left {
    width: 1fr;
    margin-right: 1;
}

.lotto-right {
    width: 2fr;
}

.lotto-numbers {
    height: auto;
    margin-bottom: 1;
}

.lotto-buttons {
    height: auto;
    align: center middle;
}

.lotto-buttons Button {
    margin-right: 1;
    min-width: 16;
}

/* Exchange 영역 */
.exchange-row {
    height: auto;
    align: left middle;
}

.exchange-input {
    width: 20;
    margin-right: 1;
}

/* 알림/상태 */
.notice {
    color: $warning;
    text-align: center;
    padding: 1;
    border: solid $warning;
    margin-top: 1;
}

.info-text {
    color: $text-dim;
}

.status-msg {
    margin-bottom: 1;
    padding: 1;
    color: $secondary;
    background: $bg-box;
    border: solid $border;
}

.hidden {
    display: none;
}

/* Input 스타일 */
.lotto-input {
    width: 6;
    margin-right: 1;
    text-align: center;
    color: $warning;
    background: #1a1a1a;
    border: solid $warning;
}

/* 로또 번호 박스 */
.lotto-num-box {
    width: 5;
    height: 3;
    border: solid $warning;
    background: #1a1a1a;
    color: $warning;
    text-align: center;
    content-align: center middle;
    margin-right: 1;
}

/* Progress bar */
.progress-bar {
    height: 1;
    background: #333333;
    margin: 1 0;
}

.progress-fill {
    height: 1;
    background: $primary;
}
