/* JackpotChain TUI Styles */

/* 색상 */
$primary: #00ff88;
$secondary: #00d4ff;
$warning: #ffbd2e;
$error: #ff5f56;
$bg-dark: #0c0c0c;
$bg-box: #1a1a1a;
$border: #333333;
$text-dim: #666666;
$text: #cccccc;

/* 전역 */
Screen {
    background: $bg-dark;
}

/* 탭 바 */
#tab-bar {
    dock: top;
    height: 3;
    background: #1a1a1a;
    padding: 1;
}

.tab {
    padding: 0 2;
    margin-right: 1;
    color: $text-dim;
    background: $bg-dark;
    border: solid $border;
}

.tab.active {
    color: #000;
    background: $primary;
    border: solid $primary;
}

/* 컨텐츠 영역 */
#content {
    padding: 1;
}

ContentSwitcher > * {
    width: 100%;
}

/* 로고 */
#logo {
    text-align: center;
    color: $primary;
    margin-bottom: 1;
    height: auto;
}

/* 메인 그리드 */
#main-grid {
    height: auto;
    margin-bottom: 1;
}

/* 통계 박스 */
.stat-box {
    border: solid $border;
    background: $bg-box;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

#main-grid .stat-box {
    width: 1fr;
    margin-right: 1;
}

/* 박스 제목 */
.box-title {
    color: $primary;
    text-style: bold;
    border-bottom: solid $border;
    margin-bottom: 1;
}

.box-title-gold {
    color: $warning;
    text-style: bold;
    text-align: center;
}

/* 통계 행 */
Horizontal {
    height: auto;
}

.stat-label {
    color: $text-dim;
    width: 12;
}

.stat-value {
    color: $text;
}

/* 색상 */
.green { color: $primary; }
.cyan { color: $secondary; }
.yellow { color: $warning; }
.red { color: $error; }

/* 잭팟 박스 */
#jackpot-box {
    border: solid $warning;
    background: $bg-box;
    padding: 1;
    text-align: center;
    height: auto;
    width: 1fr;
}

.jackpot-amount {
    color: $primary;
    text-style: bold;
    text-align: center;
}

.prize-info {
    color: $text-dim;
    text-align: center;
}

/* 버튼 */
.action-buttons {
    height: auto;
    margin-top: 1;
}

.action-buttons Button {
    margin-right: 1;
}

/* 테이블 */
DataTable {
    height: 8;
    margin-bottom: 1;
}

DataTable > .datatable--header {
    color: $primary;
    background: $bg-dark;
}

/* 로또 페이지 전용 */
.lotto-top {
    height: auto;
    margin-bottom: 1;
}

.lotto-left {
    width: 1fr;
    margin-right: 1;
}

.lotto-right {
    width: 2fr;
}

.lotto-numbers {
    height: 3;
    margin-bottom: 1;
}

.lotto-input {
    width: 8;
    margin-right: 1;
    text-align: center;
}

.lotto-buttons {
    height: auto;
}

.lotto-buttons Button {
    margin-right: 1;
    min-width: 12;
}

/* Exchange 영역 */
.exchange-row {
    height: auto;
    align: left middle;
}

.exchange-input {
    width: 20;
    margin-right: 1;
}

/* 알림/상태 */
.notice {
    color: $warning;
    text-align: center;
    padding: 1;
    border: solid $warning;
    margin-top: 1;
}

.info-text {
    color: $text-dim;
}

.status-msg {
    margin-bottom: 1;
    padding: 1;
    color: $secondary;
    background: $bg-box;
    border: solid $border;
}

.hidden {
    display: none;
}
